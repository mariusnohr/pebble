{
  "name": "pebble",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm sdk:build && next dev",
    "build": "pnpm sdk:build && pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "sdk:build": "node scripts/build-sdk.mjs && tsc -p packages/analytics/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:rehearse": "node --import tsx scripts/rehearse-cutover.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.67.0",
    "marked": "^16.4.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qrcode.react": "^4.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "better-auth": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "auth": "1.7.18"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module"
}
