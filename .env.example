DATABASE_URL=postgresql://localhost:5432/pebble
APP_URL=http://localhost:3000
# Generate at least 32 random bytes; use Nohr secret generation on hosted targets.
BETTER_AUTH_SECRET=
# First operator to verify claims the legacy Pebble organization.
OPERATOR_EMAILS=
# Keep production closed throughout the rollback window. Preview uses true.
SIGNUP_OPEN=false
# Enable only behind a trusted proxy supplying the LAST X-Forwarded-For entry.
TRUST_PROXY=false
# Use log only for local development/preview. Production uses Resend.
EMAIL_TRANSPORT=log
EMAIL_FROM=
RESEND_API_KEY=
# Retain the EXISTING value on hosted targets until M2, for old-release rollback.
# This release never reads it. No new admin password is needed.
ADMIN_PASSWORD_HASH=
# Integration tests require a separate disposable pebble_test* database.
# TEST_DATABASE_URL=
